# Copy this template locally or run tools/configure-env.mjs init.
# Never commit the real .env or include its values in screenshots.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=change_this_db_password
DATABASE_URL=postgresql://taskflow_user:change_this_db_password@postgres:5432/taskflow
REDIS_URL=redis://redis:6379
JWT_SECRET=replace_with_a_long_random_secret
PORT=3000

# Compose host publishing only. Nginx always listens on container port 80.
# This computer uses 8081 in its private .env because Oracle occupies 8080.
FRONTEND_HOST_PORT=8080

# Public Docker Hub username; access tokens belong in Docker login/GitHub secrets.
DOCKERHUB_USERNAME=YOUR_DOCKERHUB_USERNAME
