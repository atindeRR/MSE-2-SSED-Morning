# TaskFlow Environment Configuration
# Copy this file to .env and replace placeholder values
# NEVER commit .env to version control

# PostgreSQL Configuration
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=change_this_to_a_secure_password

# Database Connection URL (constructed from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Secret - REQUIRED: Generate a strong random secret (min 32 chars)
# Example: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Backend Port
PORT=3000

# Docker Hub Username (required for deployment compose)
DOCKERHUB_USERNAME=your_dockerhub_username