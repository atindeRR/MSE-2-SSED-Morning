# Copy this file to .env and replace every placeholder before deployment.
DOCKERHUB_USERNAME=your_dockerhub_username
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=replace_with_a_url_safe_password
DATABASE_URL=postgresql://taskflow_user:replace_with_a_url_safe_password@postgres:5432/taskflow
REDIS_URL=redis://redis:6379
JWT_SECRET=replace_with_a_long_random_secret
PORT=3000
