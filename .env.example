# ==============================================================================
# TaskFlow Environment Configuration (.env)
# Copy this file to .env and customize the values for your environment.
# Note: In Docker Compose, the backend connects to postgres and redis services
# using container hostnames ('postgres' and 'redis') rather than localhost.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=change_this_db_password

# Database & Cache Connection Strings
DATABASE_URL=postgresql://taskflow_user:change_this_db_password@postgres:5432/taskflow
REDIS_URL=redis://redis:6379

# Backend Application Settings
PORT=3000
JWT_SECRET=replace_with_a_long_random_secret

# Docker Hub Username (Used for docker-compose.deploy.yml image tags)
DOCKERHUB_USERNAME=your_dockerhub_username
